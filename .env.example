TELEGRAM_BOT_TOKEN=your_bot_token_here
DATABASE_PATH=data.sqlite
# LOG_LEVEL=warn

# Optional: comma-separated Telegram user IDs allowed to use /stats in a private chat
# BOT_OWNER_IDS=

# Optional anti-spam (defaults shown; 0 disables a cooldown / the cap)
# MENTION_GROUP_COOLDOWN_SECONDS=30
# MENTION_USER_COOLDOWN_SECONDS=10
# MENTION_MAX_MEMBERS=0

# Optional: delete service replies and the commands they answer after N seconds (0 = off)
# AUTO_DELETE_SECONDS=0

# Optional Sentry error reporting
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
